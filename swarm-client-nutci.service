# Mind the build account name and homedir (path, layout) below.
# To install, symlink or copy into the system, e.g.:
# :; ln -fsr ~abuild/jenkins-swarm/swarm-client-nutci.service /etc/systemd/system/ \
#    && systemctl daemon-reload \
#    && systemctl enable swarm-client-nutci.service \
#    && systemctl restart swarm-client-nutci.service
# Check how it goes with:
# :; journalctl -flu swarm-client-nutci.service &
# Preferably customize via drop-in files, so that your changes
# do not conflict with a new git checkout or packaged delivery,
# e.g.:
# :; mkdir -p /etc/systemd/system/swarm-client-nutci.service.d \
#    && ( (echo "[Service]" ; echo "Nice=15") \
#       > /etc/systemd/system/swarm-client-nutci.service.d/nice.conf )

[Unit]
Wants=network.service networking.service
After=network.service networking.service

[Service]
Restart=always
User=abuild
# Hold (re)start while apt/dpkg is busy, so a burst of package-triggered
# restarts collapses into one real stop at the first and one real start
# after the last. Prefixed by a plus to run fuser as root.
TimeoutStartSec=45min
ExecStartPre=+/home/abuild/jenkins-swarm/swarm-client-wait-pkgmgr.sh
ExecStartPre=-/home/abuild/jenkins-swarm/swarm-client-download.sh
ExecStart=/home/abuild/jenkins-swarm/swarm-client-nutci.sh
# Running builds may take a while to stop. Allow them to finish
# before the service stops - avoid killing via systemd default
# timeout (90s). Consider overriding with a drop-in for finite
# time that would match stalled builds for your project and worker:
TimeoutStopSec=infinity
#TimeoutStopSec=7200
ExecStop=/home/abuild/jenkins-swarm/swarm-client-nutci-stop.sh stop
# See above about tweaking this as a site-specific drop-in:
#Nice=15

[Install]
WantedBy=multi-user.target
